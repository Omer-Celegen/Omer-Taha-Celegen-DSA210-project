   "source": [
    "# Omer Taha Celegen 34321\n",
    "import yfinance as yf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "import ssl\n",
    "\n",
    "ssl._create_default_https_context = ssl._create_unverified_context\n",
    "sns.set_theme(style=\"whitegrid\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "60e51942",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Data Collection\n",
    "start, end = \"2021-01-01\", \"2026-01-01\"\n",
    "\n",
    "# Acquiring the Silver prices from yahoo's finance library     \n",
    "silver = yf.download(\"SI=F\", start=start, end=end, progress=False)['Close']\n",
    "silver = pd.DataFrame(silver).rename(columns={silver.columns[0]: 'Silver_Price'})\n",
    "\n",
    "# Fetch FED Rates directly from FRED with pandas\n",
    "fed = pd.read_csv(\"https://fred.stlouisfed.org/graph/fredgraph.csv?id=FEDFUNDS\", index_col=0, parse_dates=True)\n",
    "fed.columns = ['Interest_Rate']\n",
    "\n",
    "# 2. Merging and Enrichment the datasets\n",
    "fed = fed.loc[start:end]\n",
    "fed['Rate_Category'] = fed['Interest_Rate'].diff().apply(lambda x: 'Increase' if x > 0 else ('Decrease' if x < 0 else 'Stable'))\n",
    "data = silver.join(fed, how='left').ffill().dropna()\n",
    "\n",
    "# Calculate returns\n",
    "data['Returns'] = data['Silver_Price'].pct_change()\n",
    "data = data.dropna()\n",
    "\n",
    "data.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "43228168",
   "metadata": {},
   "source": [
    "## 3. Exploratory Data Analysis (EDA)\n",
    "\n",
    "### 3.1. Time Series Analysis: Silver Prices vs. FED Interest Rates\n",
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "05133e55",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax1 = plt.subplots(figsize=(12, 5))\n",
    "ax1.plot(data.index, data['Silver_Price'], color='blue', label='Silver Price')\n",
    "ax1.set_ylabel('Silver Price (USD)', color='blue', fontweight='bold')\n",
    "\n",
    "ax2 = ax1.twinx()\n",
    "ax2.step(data.index, data['Interest_Rate'], color='red', alpha=0.5, label='FED Rate')\n",
    "ax2.set_ylabel('FED Interest Rate (%)', color='red', fontweight='bold')\n",
    "\n",
    "plt.title('Silver Price vs FED Interest Rate (2021-2026)', fontweight='bold')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8347cade",
   "metadata": {},
   "source": [
    "### 3.2. Distribution and Correlation Analysis\n",
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e623c711",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a multi-plot figure\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Plot 1: Distribution of Silver Returns\n",
    "sns.histplot(data['Returns'], kde=True, color='purple', ax=axes[0])\n",
    "axes[0].set_title('Distribution of Daily Silver Returns', fontweight='bold')\n",
    "\n",
    "# Plot 2: Correlation Heatmap\n",
    "sns.heatmap(data[['Silver_Price', 'Interest_Rate', 'Returns']].corr(), annot=True, cmap='coolwarm', fmt=\".2f\", ax=axes[1])\n",
    "axes[1].set_title('Correlation Matrix', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ab18f65f",
   "metadata": {},
   "source": [
    "## 4. Hypothesis Testing & Assumption Verification\n",
    "\n",
    "### 4.1. Checking Normallity Assumptions\n",
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d86a9fd2",
   "metadata": {},
   "outputs": [],
   "source": [
    "inc = data[data['Rate_Category'] == 'Increase']['Returns']\n",
    "others = data[data['Rate_Category'] != 'Increase']['Returns']\n",
    "\n",
    "# Shapiro-Wilk Test for Normality\n",
    "shapiro_inc_stat, shapiro_inc_p = stats.shapiro(inc)\n",
    "shapiro_oth_stat, shapiro_oth_p = stats.shapiro(others)\n",
    "\n",
    "print(f\"Normality Test (Hike Days)    -> P-Value: {shapiro_inc_p:.4e}\")\n",
    "print(f\"Normality Test (Other Days)   -> P-Value: {shapiro_oth_p:.4e}\")\n",
    "\n",
    "if shapiro_inc_p < 0.05 or shapiro_oth_p < 0.05:\n",
    "    print(\"\\nResult: Data heavily violates the normality assumption (p < 0.05).\")\n",
    "    print(\"Therefore, a parametric Independent T-Test is statistically flawed.\")\n",
    "    print(\"We MUST use a Non-Parametric alternative: Mann-Whitney U Test.\")\n",
    "else:\n",
    "    print(\"\\nResult: Data is normally distributed. Proceeding with T-Test.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5191b23c",
   "metadata": {},
   "source": [
    "### 4.2. Executing Multiple Hypothesis Tests\n",
    "1. **Test 1 (Non-Parametric):** Mann-Whitney U test to safely evaluate if the distribution of silver returns differs during FED rate hikes.\n",
    "2. **Test 2 (Parametric Comparison):** A Spearman Rank Correlation Test to measure monotonic dependencies without assuming normality."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cf8592c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "#TEST 1: Mann-Whitney U Test (Safe from normality violations)\n",
    "u_stat, mw_p_val = stats.mannwhitneyu(inc, others, alternative='two-sided')\n",
    "print(\"TEST 1: Mann-Whitney U Test\")\n",
    "print(f\"U-Statistic: {u_stat:.4f} | P-Value: {mw_p_val:.4f}\")\n",
    "print(f\"Outcome: {'Statistically Significant differences' if mw_p_val < 0.05 else 'Not Statistically Significant'}\\n\")\n",
    "\n",
    "#TEST 2: Spearman Rank Correlation Test\n",
    "spearman_corr, spearman_p = stats.spearmanr(data['Interest_Rate'], data['Silver_Price'])\n",
    "print(\"TEST 2: Spearman Rank Correlation Test\")\n",
    "print(f\"Spearman Coefficients: {spearman_corr:.4f} | P-Value: {spearman_p:.4e}\")\n",
    "print(f\"Outcome: {'Statistically Significant correlation' if spearman_p < 0.05 else 'No Significant Monotonic Correlation'}\")"
   ]
  }
 ],
